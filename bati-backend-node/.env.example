# ==========================================================
# BATI Construction - Backend (bati-backend-node)
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file (it is already git-ignored).
# ==========================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bati-construction?retryWrites=true&w=majority
MONGODB_URI=

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# CORS - comma-separated list of allowed frontend origins (no trailing slash)
# Local dev example: http://localhost:5173
# Production example: https://bati-construction.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLIENT_URL=http://localhost:5173
