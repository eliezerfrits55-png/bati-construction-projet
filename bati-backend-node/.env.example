PORT=5000
NODE_ENV=development

# MongoDB Atlas (valeur fictive à remplacer localement et dans Render)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bati-construction

# JWT (valeur fictive à remplacer)
JWT_SECRET=replace_with_a_long_random_secret
